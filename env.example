# Copy to `.env` and fill in the blanks:
#     Copy-Item env.example .env
# `.env` is gitignored and must stay that way.

# ── Database (already working, no change needed) ──────────────────────
LEAD_ENGINE_DSN=postgresql://lead_engine:lead_engine_dev@127.0.0.1:5433/lead_engine
LEAD_ENGINE_TEST_DSN=postgresql://lead_engine:lead_engine_dev@127.0.0.1:5433/lead_engine

# ── Discovery: SearchAPI (Google Maps) ────────────────────────────────
# https://www.searchapi.io  -- 100 free searches, ONE TIME, non-renewing.
# The scarce resource in the whole system. One search returns 20 places, and
# every query is billed -- unlike a category filter, which was free.
SEARCHAPI_KEY=

# Credits remaining on the CURRENT key. The real ledger lives in Postgres, keyed
# on a fingerprint of the key itself, so rotating to a fresh key opens a fresh
# allocation automatically and keeps the old key's spend history. This value seeds
# a new key's row; it is a backstop, not the accounting.
#
# Set it to what the key actually has left, not what it started with.
LEAD_ENGINE_SEARCH_BUDGET=50

# ── Enrichment: TinyFish (primary) ────────────────────────────────────
# https://agent.tinyfish.ai/sign-up
# Search and Fetch are FREE on every plan and consume zero credits -- capped by
# rate only (30 search queries/min, 150 fetch URLs/min). The 500 signup credits
# are for Agent/Browser, which this project does not use.
TINYFISH_API_KEY=

# ── Enrichment: Firecrawl (fallback, metered) ─────────────────────────
# https://www.firecrawl.dev  -- 1,000 credits/month, renewing.
# Only for jobs TinyFish cannot do. Left blank, TinyFish handles everything.
FIRECRAWL_API_KEY=

# ── LLM providers, tried in this order ────────────────────────────────
# https://console.groq.com   free, no card, 14,400 req/day, tool use on every model
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# https://build.nvidia.com   trial credits, 40 req/min
NVIDIA_API_KEY=

# Any or all of the three may stay blank. With every one blank a run still
# completes using deterministic copy -- that is a guarantee, not a fallback.

# No sender name here. The system generates outreach text but never sends it --
# the operator does, by hand. The signature on a generated email or DM is
# operator config, not environment config, so it lives in `goals.spec` alongside
# city, niches and budgets. Left unset, the copy simply carries no sign-off.
