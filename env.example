# Copy to `.env` and fill in:  cp env.example .env
# `.env` is gitignored and must stay that way.

# ── Database ──────────────────────────────────────────────────────────
# Host port 5433 matches docker-compose.yml. Not 5432, to avoid colliding
# with a local Postgres install or another project's container.
LEAD_ENGINE_DSN=postgresql://lead_engine:lead_engine_dev@127.0.0.1:5433/lead_engine

# Integration tests skip themselves unless this is set. Point it at the same
# database; each test runs in its own throwaway schema.
LEAD_ENGINE_TEST_DSN=postgresql://lead_engine:lead_engine_dev@127.0.0.1:5433/lead_engine

# ── Discovery ─────────────────────────────────────────────────────────
SEARCHAPI_KEY=
# Hard ceiling on billed searches per run. Queries are billed guesses, not free
# filters, so an unbounded sweep can cost several dollars while still debugging.
LEAD_ENGINE_SEARCH_BUDGET=40

# ── Enrichment ────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=

# ── LLM providers, tried in this order ────────────────────────────────
# Any or all may be blank. With every one blank the run still completes using
# deterministic copy - that is a guarantee, not a fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# ── Outreach ──────────────────────────────────────────────────────────
# Signs the generated messages.
LEAD_ENGINE_SENDER_NAME=
