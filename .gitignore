# ── Secrets. Never commit. ────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json
service-account*.json

# The whole directory, not a filename pattern. Google names service-account keys
# `<project-id>-<hash>.json`, which matches none of the patterns above -- so a
# pattern-based rule silently fails to cover the exact file it exists to protect.
credentials/
!credentials/.gitkeep

# ── Browser session data ──────────────────────────────
# Chrome profiles carry live cookies and auth tokens.
chrome-profile/
browser-data/
*.cookies
cookies.json

# ── Generated lead data ───────────────────────────────
# Commercial output, not source. Lives in Postgres.
outputs/
exports/
*.xlsx
*.csv

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── Local infra ───────────────────────────────────────
pgdata/
docker-compose.override.yml

# ── Editors / OS ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
